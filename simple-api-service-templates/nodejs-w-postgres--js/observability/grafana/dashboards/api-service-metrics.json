  "description": "RED metrics for the API, Node.js runtime, and the PostgreSQL pool. Alloy scrapes /metrics and remote-writes to Mimir. Request series use the Express route template. /health and /metrics are excluded. status_code is on the counter only.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Logs",
      "tooltip": "API service logs",
      "type": "link",
      "url": "/d/api-service-logs"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
