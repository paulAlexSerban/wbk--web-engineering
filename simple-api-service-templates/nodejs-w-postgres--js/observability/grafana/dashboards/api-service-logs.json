      "pluginVersion": "11.5.2",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  ifNull(nullIf(LogAttributes['route'], ''), 'unknown') AS route,\n  ifNull(nullIf(JSONExtractString(LogAttributes['err'], 'type'), ''), 'unknown') AS reason,\n  count() AS failures\nFROM otel_logs\nWHERE ResourceAttributes['service.name'] = '$service'\n  AND SeverityText IN ('error', 'fatal')\n  AND Timestamp BETWEEN $__fromTime AND $__toTime\nGROUP BY route, reason\nORDER BY failures DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top 10 Failing Routes",
