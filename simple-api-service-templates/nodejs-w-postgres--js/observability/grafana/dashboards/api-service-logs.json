          "editorType": "sql",
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT\n  toStartOfMinute(Timestamp) AS time,\n  ifNull(nullIf(JSONExtractString(LogAttributes['err'], 'type'), ''), 'unknown') AS reason,\n  count() AS error_count\nFROM otel_logs\nWHERE ResourceAttributes['service.name'] = '$service'\n  AND SeverityText IN ('error', 'fatal')\n  AND Timestamp BETWEEN $__fromTime AND $__toTime\nGROUP BY time, reason\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Error Rate Over Time by Reason",
      "type": "timeseries"
    },
