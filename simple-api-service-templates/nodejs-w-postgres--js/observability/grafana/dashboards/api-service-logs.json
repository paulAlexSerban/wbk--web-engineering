          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT\n  toStartOfMinute(Timestamp) AS time,\n  ResourceAttributes['service.name'] AS service,\n  count() AS error_count\nFROM otel_logs\nWHERE SeverityText IN ('error', 'fatal')\n  AND Timestamp BETWEEN $__fromTime AND $__toTime\nGROUP BY time, service\nORDER BY time",
