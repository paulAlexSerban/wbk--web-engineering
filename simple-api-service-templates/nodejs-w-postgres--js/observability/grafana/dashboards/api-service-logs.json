          "expr": "topk(10, sum by (route, code, constraint) (count_over_time({service=~\"$service\", level=~\"error|fatal\"} | json route=\"route\", code=\"err.code\", constraint=\"err.constraint\" | label_format route=`{{ or .route \"unknown\" }}`, code=`{{ or .code \"none\" }}`, constraint=`{{ or .constraint \"none\" }}` [$__range])))",
