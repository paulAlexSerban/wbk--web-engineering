          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  countIf(SeverityText IN ('error', 'fatal')) AS error_count,\n  count() AS total_count,\n  round(error_count / total_count * 100, 2) AS error_rate_pct\nFROM otel_logs\nWHERE ResourceAttributes['service.name'] = '$service'\n  AND Timestamp BETWEEN $__fromTime AND $__toTime",
          "refId": "A"
        }
      ],
      "title": "Aggregated Error Rate",
