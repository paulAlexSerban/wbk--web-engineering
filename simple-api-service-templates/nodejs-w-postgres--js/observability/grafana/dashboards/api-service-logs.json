    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Unique and foreign-key violations (HTTP 409). Grouped by route template, reason, and err.constraint. These are warn lines and are excluded from the server-error panels.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
