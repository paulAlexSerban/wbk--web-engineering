      "pluginVersion": "12.4.11",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum by (route, reason, constraint) (count_over_time({service=~\"$service\", level=\"warn\"} | json route=\"route\", reason=\"reason\", constraint=\"err.constraint\" | reason=~\"unique_violation|foreign_key_violation\" | label_format route=`{{ or .route \"unknown\" }}`, constraint=`{{ or .constraint \"none\" }}` [$__auto]))",
          "legendFormat": "{{route}} {{reason}} {{constraint}}",
          "queryType": "range",
          "refId": "A",
          "step": "1m"
        }
      ],
      "title": "Conflicts by route and constraint",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Successful POST /api/products (HTTP 201) beside duplicate-SKU conflicts (err.code 23505, constraint products_sku_key). A short conflict spike is one client retrying. A ratio that stays high as creates climb means the SKU generator is too predictable.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 44
      },
      "id": 206,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=~\"$service\", level=\"info\"} | json route=\"route\", method=\"req.method\", status=\"res.statusCode\" | route=\"/api/products\" | method=\"POST\" | status=\"201\" [$__auto]))",
          "legendFormat": "creates",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=~\"$service\", level=\"warn\"} | json route=\"route\", code=\"err.code\", constraint=\"err.constraint\" | route=\"/api/products\" | code=\"23505\" | constraint=\"products_sku_key\" [$__auto]))",
          "legendFormat": "sku conflicts",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "title": "Product creates and SKU conflicts",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "SKU conflicts divided by conflicts plus successful creates, over a rolling 15 minutes. Above 1% and held there is the signal to widen SKU randomness. One collision does not move this for long.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 44
      },
      "id": 207,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.4.11",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=~\"$service\", level=\"info\"} | json route=\"route\", method=\"req.method\", status=\"res.statusCode\" | route=\"/api/products\" | method=\"POST\" | status=\"201\" [15m])) or sum(count_over_time({service=~\"$service\"}[15m])) * 0",
          "hide": true,
          "queryType": "instant",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=~\"$service\", level=\"warn\"} | json route=\"route\", code=\"err.code\", constraint=\"err.constraint\" | route=\"/api/products\" | code=\"23505\" | constraint=\"products_sku_key\" [15m])) or sum(count_over_time({service=~\"$service\"}[15m])) * 0",
          "hide": true,
          "queryType": "instant",
          "refId": "B"
        },
        {
          "datasource": {
            "name": "Expression",
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$B / ($A + $B + 1e-9)",
          "refId": "C",
          "type": "math"
        }
      ],
      "title": "SKU conflict ratio (15m)",
      "type": "stat"
    },
