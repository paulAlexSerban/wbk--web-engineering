  "panels": [
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) AS time,\n  sum(Count) / $__interval_s AS value\nFROM otel.otel_metrics_histogram\nWHERE $__timeFilter(TimeUnix)\n  AND MetricName = 'http_request_duration_seconds'\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Latency p95",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n  $__timeInterval(Timestamp) AS time,\n  quantile(0.95)(toFloat64OrZero(LogAttributes['duration_ms'])) / 1000 AS value\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName = 'api-service'\n  AND mapContains(LogAttributes, 'duration_ms')\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Error rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) AS time,\n  sumIf(Count, Attributes['status_code'] LIKE '5%') / nullIf(sum(Count), 0) AS value\nFROM otel.otel_metrics_histogram\nWHERE $__timeFilter(TimeUnix)\n  AND MetricName = 'http_request_duration_seconds'\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "id": 4,
      "title": "API logs",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 2,
          "queryType": "logs",
          "rawSql": "SELECT\n  Timestamp AS timestamp,\n  Body AS body,\n  SeverityText AS level\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName = 'api-service'\nORDER BY Timestamp DESC\nLIMIT 1000",
          "refId": "A"
        }
      ]
    }
  ],
